[Desktop Entry]
Type=Application
Name=OweeCapture
GenericName=Screen capture and recording
Comment=Screenshots with an annotation editor, screen recording with audio and webcam, and a presentation drawing mode
Exec=oweecapture
Icon=oweecapture
Terminal=false
StartupWMClass=oweecapture
Categories=AudioVideo;Recorder;
Keywords=screenshot;screen;record;capture;video;
Actions=Shot;Record;Present;

[Desktop Action Shot]
Name=Take a screenshot
Exec=oweecapture --shot

[Desktop Action Record]
Name=Start or stop recording
Exec=oweecapture --record

[Desktop Action Present]
Name=Presentation mode (draw on screen)
Exec=oweecapture --present
